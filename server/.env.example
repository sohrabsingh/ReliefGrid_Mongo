# Local single-node replica set (see docker-compose.yml, or run.ps1/restart.ps1 which
# start one on port 27018 automatically) or a MongoDB Atlas free-tier cluster.
# Change streams require MongoDB to be running as a replica set - a standalone mongod
# will not work. Port 27017 is deliberately NOT the default here - that's often an
# existing standalone MongoDB service (Windows installs one by default), and pointing
# at it would either fail outright or silently not be the replica set this needs.
MONGODB_URI=mongodb://localhost:27018/reliefgrid?replicaSet=rs0&directConnection=true

PORT=4000
JWT_SECRET=reliefgrid-dev-secret-change-me
CLIENT_ORIGIN=http://localhost:5173

# Optional - only needed if you want the SMS intake route to actually send/receive via Twilio.
# Without these, /api/sms/inbound still works for local testing (simulates the Twilio webhook shape).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
